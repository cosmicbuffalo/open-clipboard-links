#!/bin/bash
set -euo pipefail

LABEL="com.cosmicbuffalo.open-clipboard-links"
PLIST_DEST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="$HOME/Library/Logs"
UID_NUM=$(id -u)
DOMAIN="gui/${UID_NUM}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/open-clipboard-links"
CONFIG_PATH="$CONFIG_DIR/config.sh"

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_EXAMPLE_PATH="$PROJECT_DIR/config.sh.example"

usage() {
  cat <<EOF
Usage: open-clipboard-links <command>

Commands:
  start     Load and start the background daemon (auto-starts on login too)
  stop      Unload and stop the background daemon
  restart   Restart the daemon (picks up script changes)
  status    Show whether the daemon is running
  logs      Tail the daemon's stdout/stderr logs
  config    Open the config file in \$EDITOR (seeding it from the example if missing)
  help      Show this usage message
EOF
}

require_plist() {
  if [[ ! -f "$PLIST_DEST" ]]; then
    echo "Error: $PLIST_DEST not found. Run install.sh first." >&2
    exit 1
  fi
}

cmd_start() {
  require_plist
  launchctl bootstrap "$DOMAIN" "$PLIST_DEST" 2>/dev/null || true
  launchctl kickstart -k "$DOMAIN/$LABEL"
  echo "Started $LABEL"
}

cmd_stop() {
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || echo "Already stopped."
  echo "Stopped $LABEL"
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  local info
  if ! info=$(launchctl print "$DOMAIN/$LABEL" 2>/dev/null); then
    echo "not running"
    return
  fi

  local state pid
  state=$(awk -F'= ' '/^\tstate = /{print $2; exit}' <<< "$info")
  pid=$(awk -F'= ' '/^\tpid = /{print $2; exit}' <<< "$info")

  if [[ "$state" == "running" ]]; then
    echo "running (pid $pid)"
  else
    echo "loaded but not running (state: $state)"
  fi
}

cmd_logs() {
  tail -f "$LOG_DIR/open-clipboard-links.log" "$LOG_DIR/open-clipboard-links.err.log"
}

cmd_config() {
  if [[ ! -f "$CONFIG_PATH" ]]; then
    if [[ ! -f "$CONFIG_EXAMPLE_PATH" ]]; then
      echo "Error: no config at $CONFIG_PATH and no example at $CONFIG_EXAMPLE_PATH to seed from." >&2
      exit 1
    fi
    mkdir -p "$CONFIG_DIR"
    cp "$CONFIG_EXAMPLE_PATH" "$CONFIG_PATH"
    echo "Seeded $CONFIG_PATH from config.sh.example"
  fi

  "${EDITOR:-vi}" "$CONFIG_PATH"
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  config) cmd_config ;;
  -h|--help|help) usage; exit 0 ;;
  "") usage >&2; exit 1 ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
